page { background: #f6f5f2; }
.page-container { min-height: 100vh; padding: 0 24rpx 32rpx; box-sizing: border-box; }
.page-nav { position: relative; display: flex; align-items: center; justify-content: center; height: calc(104rpx + env(safe-area-inset-top)); padding-top: env(safe-area-inset-top); box-sizing: border-box; }
.nav-title { color: #2f6b57; font-size: 31rpx; font-weight: 750; }
.nav-back { position: absolute; left: 0; top: calc(26rpx + env(safe-area-inset-top)); display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border: 1rpx solid #dfe9e1; border-radius: 14rpx; background: #fff; color: #2c463b; font-size: 48rpx; font-weight: 300; line-height: 46rpx; box-sizing: border-box; }
.order-card { margin-bottom: 18rpx; padding: 0 21rpx 21rpx; border: 1rpx solid #ebe8e2; border-radius: 22rpx; background: #fff; box-shadow: 0 7rpx 18rpx rgba(47, 107, 87,.03); }
.order-header { display: flex; align-items: center; justify-content: space-between; height: 78rpx; border-bottom: 1rpx solid #f0eeea; }
.order-id { color: #83998d; font-size: 21rpx; }
.order-status { padding: 5rpx 10rpx; border-radius: 6rpx; font-size: 21rpx; font-weight: 650; }
.order-status.pendingPayment { background: #fff6ef; color: #d9784d; }.order-status.pendingReceipt { background: #eef7f3; color: #43836d; }.order-status.pendingShipment { background: #edf6ef; color: #4d806b; }.order-status.completed { background: #f3f5f1; color: #7b8797; }
.product-item { display: flex; align-items: center; padding: 19rpx 0; }
.product-cover { width: 112rpx; height: 142rpx; margin-right: 16rpx; border-radius: 10rpx; background: #eff3ef; }.product-cover-placeholder { display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 20rpx; }
.product-info { flex: 1; min-width: 0; }.product-title { overflow: hidden; color: #294438; font-size: 27rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }.product-specs { margin-top: 10rpx; color: #8994a4; font-size: 21rpx; }.product-price { color: #ed633c; font-size: 27rpx; font-weight: 750; }
.order-summary { display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; padding-top: 17rpx; border-top: 1rpx solid #f0eeea; color: #809287; font-size: 22rpx; }.total-amount { color: #ed633c; font-size: 30rpx; font-weight: 750; }
.handover-note { display: flex; align-items: center; margin-top: 15rpx; padding: 11rpx 12rpx; border-radius: 12rpx; background: #fff8ee; color: #a5783f; font-size: 20rpx; line-height: 1.45; }.handover-note.received { background: #edf7ef; color: #4d806b; }.handover-mark { display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; margin-right: 8rpx; border-radius: 50%; background: rgba(255,255,255,.85); font-size: 18rpx; font-weight: 750; flex: none; }.order-actions { display: flex; justify-content: flex-end; margin-top: 17rpx; }.order-actions button { display: flex; align-items: center; justify-content: center; min-width: 164rpx; height: 58rpx; margin: 0; border-radius: 14rpx; background: #2f6b57; color: #fff; font-size: 23rpx; line-height: 58rpx; }
.empty-orders { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; }.empty-icon { display: flex; align-items: center; justify-content: center; width: 110rpx; height: 110rpx; margin-bottom: 18rpx; border-radius: 50%; background: #eceff2; color: #789080; font-size: 22rpx; }.empty-text { color: #8c97a7; font-size: 27rpx; }.empty-btn { display: flex; align-items: center; justify-content: center; width: 190rpx; height: 70rpx; margin-top: 24rpx; border-radius: 16rpx; background: #2f6b57; color: #fff; font-size: 25rpx; }.loading-state { padding: 34rpx; color: #9daaa1; font-size: 25rpx; text-align: center; }.retry, .more { color: #df633e; }
