page { background: #f6f5f2; color: #2f6b57; }
.container { padding-bottom: calc(148rpx + env(safe-area-inset-bottom)); }
.detail-nav { position: relative; display: flex; align-items: center; justify-content: center; height: calc(104rpx + env(safe-area-inset-top)); padding-top: env(safe-area-inset-top); background: #f6f5f2; box-sizing: border-box; }
.nav-title { color: #2f6b57; font-size: 31rpx; font-weight: 750; line-height: 104rpx; }
.nav-back { position: absolute; left: 24rpx; top: calc(26rpx + env(safe-area-inset-top)); display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border: 1rpx solid #dfe9e1; border-radius: 14rpx; background: #fff; color: #2c463b; font-size: 48rpx; font-weight: 300; line-height: 46rpx; box-sizing: border-box; }
.book-main-info-section { overflow: hidden; margin: 0 24rpx; border: 1rpx solid #ebe8e2; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(47, 107, 87,.035); }
.image-container { display: flex; align-items: center; justify-content: center; width: 100%; height: 550rpx; background: #faf8f4; }
.image-swiper, .slide-image { width: 100%; height: 100%; }
.image-placeholder-block { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #a4b0a7; font-size: 28rpx; }
.image-count { position: absolute; right: 22rpx; bottom: 18rpx; padding: 7rpx 14rpx; border-radius: 18rpx; background: rgba(47, 107, 87,.65); color: #fff; font-size: 21rpx; }
.meta-info { padding: 26rpx 26rpx 28rpx; }
.price-line { display: flex; align-items: baseline; margin-bottom: 14rpx; }
.current-price { color: #ed633c; font-size: 50rpx; font-weight: 750; }
.original-price { margin-left: 15rpx; color: #9daaa1; font-size: 25rpx; text-decoration: line-through; }
.title-author { display: -webkit-box; overflow: hidden; color: #2f6b57; font-size: 35rpx; font-weight: 750; line-height: 1.36; text-overflow: ellipsis; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.author-name { color: #7a8e82; font-size: 26rpx; font-weight: 400; }
.book-tags { display: flex; gap: 10rpx; margin-top: 15rpx; }
.course-tag, .condition-tag { padding: 7rpx 12rpx; border-radius: 7rpx; font-size: 21rpx; line-height: 1; }
.course-tag { background: #edf6ef; color: #4d806b; }
.condition-tag { background: #eef7f3; color: #43836d; }
.code-share-line { display: flex; align-items: center; justify-content: space-between; margin-top: 19rpx; color: #83998d; font-size: 22rpx; }
.share-button { display: flex; align-items: center; justify-content: center; width: 116rpx; height: 50rpx; margin: 0; padding: 0; border: 1rpx solid #dce8df; border-radius: 12rpx; background: #fff; box-sizing: border-box; color: #566f62; font-size: 22rpx; line-height: 50rpx; }
.share-button::after { border: 0; }
.book-extra-info-section, .seller-info-section, .book-content-section { width: auto; margin: 20rpx 24rpx 0; padding: 25rpx 24rpx; border: 1rpx solid #ebe8e2; border-radius: 22rpx; background: #fff; box-sizing: border-box; box-shadow: 0 7rpx 18rpx rgba(47, 107, 87,.03); }
.section-title-detail { position: relative; margin-bottom: 19rpx; padding-left: 15rpx; color: #2f6b57; font-size: 29rpx; font-weight: 750; }
.section-title-detail::before { position: absolute; top: 6rpx; left: 0; width: 6rpx; height: 27rpx; border-radius: 4rpx; background: #ef653e; content: ''; }
.extra-info-grid { display: flex; flex-wrap: wrap; }
.extra-info-item { width: 50%; padding: 9rpx 0; color: #566f62; font-size: 24rpx; box-sizing: border-box; }
.extra-info-label { color: #a5b1a8; }
.extra-info-value { color: #566f62; }
.seller-card { display: flex; align-items: center; }
.seller-avatar, .avatar-placeholder-block { width: 72rpx; height: 72rpx; margin-right: 16rpx; border-radius: 50%; background: #f1f4f0; }
.seller-name { color: #2c463b; font-size: 26rpx; font-weight: 650; }
.content-text { color: #62786c; font-size: 27rpx; line-height: 1.72; white-space: pre-wrap; }
.bottom-actions { position: fixed; bottom: 0; left: 0; z-index: 100; display: flex; width: 100%; padding: 17rpx 24rpx; padding-bottom: calc(17rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8e5df; background: rgba(255,255,255,.98); box-shadow: 0 -7rpx 18rpx rgba(47, 107, 87,.04); box-sizing: border-box; }
.action-button { display: flex; flex: 1; align-items: center; justify-content: center; height: 76rpx; border-radius: 16rpx; font-size: 28rpx; font-weight: 700; }
.add-to-cart-button { margin-right: 15rpx; border: 1rpx solid #dce8df; background: #fff; color: #2c463b; }
.buy-now-button { background: #2f6b57; color: #fff; box-shadow: 0 7rpx 14rpx rgba(47, 107, 87,.16); }
