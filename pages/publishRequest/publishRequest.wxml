<view class="container">
  <view class="page-nav"><view class="nav-back" bindtap="goBack">‹</view><text class="nav-title">{{requestId ? '编辑求购' : '发布求购'}}</text></view>
  <form bindsubmit="submitRequestForm"><view class="form-intro"><view class="intro-title">告诉同学，你正在寻找什么</view><view class="intro-desc">清楚的课程信息和预算，会让回应更快。</view></view><view class="section info-input-section"><view class="section-title">求购信息</view><view class="input-row image-upload-row"><view class="label">参考封面</view><view class="image-uploader-container"><view class="image-preview-wrapper" wx:if="{{formData.coverImageUrl}}"><image class="preview-image" src="{{formData.coverImageUrl}}" mode="aspectFit" bindtap="previewUploadedImage"></image><view class="remove-image-btn" bindtap="removeCoverImage">×</view></view><view class="upload-btn-wrapper" wx:else bindtap="chooseCoverImage"><text class="upload-icon">＋</text><text class="upload-text">添加封面</text></view></view></view><view class="input-row"><view class="label">期望价格</view><input class="input-field price-input" name="expectedPrice" type="digit" value="{{formData.expectedPrice}}" placeholder="请输入预算" bindinput="handleInputChange" data-field="expectedPrice"/></view><view class="input-row"><view class="label">专业</view><picker class="category-picker" mode="selector" range="{{majorLabels}}" value="{{majorIndex}}" bindchange="onMajorChange"><view class="picker-value {{formData.major ? '' : 'picker-placeholder'}}">{{formData.major || '选择适用专业'}}</view></picker></view><view class="input-row"><view class="label">年级</view><picker class="category-picker" mode="selector" range="{{gradeLabels}}" value="{{gradeIndex}}" bindchange="onGradeChange"><view class="picker-value {{formData.grade ? '' : 'picker-placeholder'}}">{{formData.grade || '选择适用年级'}}</view></picker></view><view class="input-row"><view class="label">课程编号</view><input class="input-field" name="courseCode" type="text" value="{{formData.courseCode}}" placeholder="选填" bindinput="handleInputChange" data-field="courseCode"/></view><view class="input-row"><view class="label">书名</view><input class="input-field" name="title" type="text" value="{{formData.title}}" placeholder="请输入书名" bindinput="handleInputChange" data-field="title"/></view><view class="input-row"><view class="label">作者</view><input class="input-field" name="author" type="text" value="{{formData.author}}" placeholder="选填" bindinput="handleInputChange" data-field="author"/></view><view class="textarea-row"><view class="label">补充说明</view><textarea class="description-input" name="description" value="{{formData.description}}" placeholder="版本、品相、时间等要求" maxlength="200" auto-height bindinput="handleInputChange" data-field="description"></textarea></view></view><view class="submit-button-container"><button class="submit-button" form-type="submit" disabled="{{submitting}}">{{requestId ? '保存修改' : '发布求购需求'}}</button><button class="delete-button" wx:if="{{requestId}}" bindtap="deleteRequest" disabled="{{submitting}}">删除此求购</button></view></form>
</view>
