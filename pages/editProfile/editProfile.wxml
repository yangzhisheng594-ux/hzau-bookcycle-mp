<view class="container"><view class="page-nav"><view class="nav-back" bindtap="goBack">‹</view><text class="nav-title">编辑资料</text></view><view class="profile-card"><view class="avatar-block"><text class="avatar-label">个人头像</text><button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar"><image class="avatar-preview" src="{{avatarUrl || '/images/demo-avatar.png'}}"></image><text class="avatar-change">更换</text></button></view><view class="divider"></view><view class="form-item"><text class="label">昵称</text><input class="input-field" type="nickname" placeholder="请输入昵称" value="{{nickName}}" bindinput="onNicknameInput"/></view></view><button class="save-btn" bindtap="saveProfile">保存资料</button></view>
