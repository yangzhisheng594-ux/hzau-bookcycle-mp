page { background: #f6f5f2; }.container { min-height: 100vh; padding: 0 24rpx 32rpx; box-sizing: border-box; }.page-nav { position: relative; display: flex; align-items: center; justify-content: center; height: 104rpx; }.nav-title { color: #2f6b57; font-size: 31rpx; font-weight: 750; }.nav-back { position: absolute; left: 0; top: 26rpx; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border: 1rpx solid #dfe9e1; border-radius: 14rpx; background: #fff; color: #2c463b; font-size: 48rpx; font-weight: 300; line-height: 46rpx; box-sizing: border-box; }.profile-card { padding: 0 24rpx; border: 1rpx solid #ebe8e2; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(47, 107, 87,.03); }.avatar-block { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; }.avatar-label, .label { color: #3d594c; font-size: 26rpx; font-weight: 650; }.avatar-wrapper { display: flex; align-items: center; margin: 0; padding: 0; background: transparent; }.avatar-wrapper::after { border: 0; }.avatar-preview { width: 92rpx; height: 92rpx; border-radius: 50%; background: #eff3ef; }.avatar-change { margin-left: 12rpx; color: #5a856f; font-size: 22rpx; }.divider { height: 1rpx; background: #f0eeea; }.form-item { display: flex; align-items: center; min-height: 94rpx; }.input-field { flex: 1; color: #566f62; font-size: 25rpx; text-align: right; }.save-btn { display: flex; align-items: center; justify-content: center; height: 84rpx; margin-top: 24rpx; border-radius: 17rpx; background: #2f6b57 !important; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 84rpx; box-shadow: 0 8rpx 16rpx rgba(47, 107, 87,.16); }
