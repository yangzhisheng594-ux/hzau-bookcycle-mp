page { background: #f6f5f2; }
.page-wrap { padding: 0 24rpx 32rpx; }
.page-nav { position: relative; display: flex; align-items: center; justify-content: center; height: calc(104rpx + env(safe-area-inset-top)); padding-top: env(safe-area-inset-top); box-sizing: border-box; }
.nav-title { color: #2f6b57; font-size: 31rpx; font-weight: 750; }
.nav-back { position: absolute; left: 0; top: calc(26rpx + env(safe-area-inset-top)); display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border: 1rpx solid #dfe9e1; border-radius: 14rpx; background: #fff; color: #2c463b; font-size: 48rpx; font-weight: 300; line-height: 46rpx; box-sizing: border-box; }
.search-bar { display: flex; align-items: center; height: 82rpx; padding-left: 20rpx; border: 1rpx solid #e7e4de; border-radius: 17rpx; background: #fff; box-shadow: 0 6rpx 15rpx rgba(47, 107, 87,.035); }
.search-bar input { flex: 1; min-height: 82rpx; color: #2c463b; font-size: 26rpx; }
.search-action { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 60rpx; margin-right: 10rpx; border-radius: 12rpx; background: #2f6b57; color: #fff; font-size: 24rpx; font-weight: 650; }
.result-count { padding: 22rpx 4rpx 12rpx; color: #7f9186; font-size: 23rpx; }
.book-list { padding: 0 20rpx; border: 1rpx solid #ebe8e2; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(47, 107, 87,.03); }
.book-card { display: flex; padding: 20rpx 0; border-bottom: 1rpx solid #f0eeea; }
.book-card:last-child { border-bottom: 0; }
.cover { width: 124rpx; height: 164rpx; border-radius: 11rpx; background: #eff3ef; flex: none; }
.placeholder { display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 21rpx; }
.book-info { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 3rpx 0 2rpx 18rpx; }
.title { display: -webkit-box; overflow: hidden; color: #294438; font-size: 28rpx; font-weight: 650; line-height: 1.42; text-overflow: ellipsis; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.meta { margin-top: 9rpx; color: #7a8e82; font-size: 22rpx; }
.course { align-self: flex-start; margin-top: 9rpx; padding: 4rpx 9rpx; border-radius: 6rpx; background: #f3f5f1; color: #8f9f94; font-size: 20rpx; }
.price { margin-top: auto; color: #ed633c; font-size: 30rpx; font-weight: 750; }
.status, .footer { padding: 72rpx 0; color: #9daaa1; font-size: 26rpx; text-align: center; }
.retry, .footer { color: #df633e; }
.footer { padding: 26rpx 0; }
