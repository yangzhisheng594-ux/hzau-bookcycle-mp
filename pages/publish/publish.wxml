<view class="container">
  <view class="page-nav"><view class="nav-back" bindtap="goBack">‹</view><text class="nav-title">{{bookId ? '编辑书籍' : '发布书籍'}}</text></view>
  <form bindsubmit="submitForm">
    <view class="form-intro"><view class="intro-title">让闲置教材继续流动</view><view class="intro-desc">填写完整信息，能让同学更快找到它。</view></view>
    <view class="section photo-section"><view class="section-title">书籍照片</view><view class="section-note">首张将作为封面</view><view class="image-uploader"><view class="image-preview-list"><view class="image-item" wx:for="{{imageUrls}}" wx:key="*this" bindtap="previewImage" data-src="{{item}}"><image src="{{item}}" mode="aspectFill"></image><view class="delete-icon" catchtap="deleteImage" data-index="{{index}}">×</view></view></view><view class="upload-button" bindtap="chooseImage" wx:if="{{imageUrls.length < 9}}"><text class="upload-icon">＋</text><text>添加照片</text></view></view></view>
    <view class="section description-section"><view class="section-title">书籍说明</view><textarea class="description-input" name="description" value="{{formData.description}}" placeholder="新旧程度、有无笔记、出售原因等" maxlength="500" auto-height bindinput="handleInputChange" data-field="description"></textarea><view class="char-count">{{formData.description.length || 0}} / 500</view></view>
    <view class="section info-input-section"><view class="section-title">基础信息</view><view class="input-row"><view class="label">出售价格</view><input class="input-field price-input" name="price" type="digit" value="{{formData.price}}" placeholder="请输入价格" bindinput="handleInputChange" data-field="price"/></view><view class="input-row"><view class="label">专业</view><picker class="category-picker" mode="selector" range="{{majorLabels}}" value="{{majorIndex}}" bindchange="onMajorChange"><view class="picker-value {{formData.major ? '' : 'picker-placeholder'}}">{{formData.major || '选择适用专业'}}</view></picker></view><view class="input-row"><view class="label">年级</view><picker class="category-picker" mode="selector" range="{{gradeLabels}}" value="{{gradeIndex}}" bindchange="onGradeChange"><view class="picker-value {{formData.grade ? '' : 'picker-placeholder'}}">{{formData.grade || '选择适用年级'}}</view></picker></view><view class="input-row"><view class="label">课程编号</view><input class="input-field" name="courseCode" type="text" value="{{formData.courseCode}}" placeholder="选填" bindinput="handleInputChange" data-field="courseCode"/></view><view class="input-row"><view class="label">图书分类</view><picker class="category-picker" mode="selector" range="{{categories}}" range-key="name" bindchange="onCategoryChange" disabled="{{!categories.length}}"><view class="picker-value">{{selectedCategoryName || '请选择分类'}}</view></picker></view><view class="input-row"><view class="label">书名</view><input class="input-field" name="title" type="text" value="{{formData.title}}" placeholder="请输入书名" bindinput="handleInputChange" data-field="title"/></view><view class="input-row"><view class="label">作者</view><input class="input-field" name="author" type="text" value="{{formData.author}}" placeholder="选填" bindinput="handleInputChange" data-field="author"/></view></view>
    <view class="submit-button-container"><button class="submit-button" form-type="submit" disabled="{{submitting}}">{{bookId ? '保存修改' : '确认发布'}}</button><button class="delete-button" wx:if="{{bookId}}" bindtap="deleteBook" disabled="{{submitting}}">下架此书</button></view>
  </form>
</view>
