page { background: #f6f5f2; }.container { padding: 0 24rpx 180rpx; box-sizing: border-box; }.page-nav { position: relative; display: flex; align-items: center; justify-content: center; height: 104rpx; }.nav-title { color: #2f6b57; font-size: 31rpx; font-weight: 750; }.nav-back { position: absolute; left: 0; top: 26rpx; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border: 1rpx solid #dfe9e1; border-radius: 14rpx; background: #fff; color: #2c463b; font-size: 48rpx; font-weight: 300; line-height: 46rpx; box-sizing: border-box; }
.form-intro { margin-bottom: 18rpx; padding: 24rpx; border-radius: 20rpx; background: #edf5ee; }.intro-title { color: #356c56; font-size: 29rpx; font-weight: 750; }.intro-desc { margin-top: 8rpx; color: #6e8c7c; font-size: 22rpx; }.section { position: relative; margin-bottom: 18rpx; padding: 24rpx; border: 1rpx solid #ebe8e2; border-radius: 22rpx; background: #fff; box-shadow: 0 7rpx 18rpx rgba(47, 107, 87,.03); }.section-title { color: #2f6b57; font-size: 29rpx; font-weight: 750; }.section-note { position: absolute; top: 28rpx; right: 24rpx; color: #9aa89e; font-size: 20rpx; }
.image-uploader, .image-preview-list { display: flex; flex-wrap: wrap; margin-top: 18rpx; }.image-item, .upload-button { width: 142rpx; height: 142rpx; margin: 0 14rpx 14rpx 0; border-radius: 12rpx; overflow: hidden; box-sizing: border-box; }.image-item { position: relative; border: 1rpx solid #e5e7eb; }.image-item image { width: 100%; height: 100%; }.delete-icon { position: absolute; top: 0; right: 0; display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border-radius: 0 0 0 10rpx; background: rgba(47, 107, 87,.65); color: #fff; font-size: 25rpx; }.upload-button { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx dashed #bdc9c0; background: #fafbfc; color: #83988d; font-size: 21rpx; }.upload-icon { color: #527861; font-size: 45rpx; line-height: 1; }
.description-input { width: 100%; min-height: 150rpx; margin-top: 18rpx; padding: 16rpx; border: 1rpx solid #e7eee8; border-radius: 12rpx; background: #fafbfc; color: #3d594c; font-size: 25rpx; line-height: 1.6; box-sizing: border-box; }.char-count { margin-top: 8rpx; color: #a4b0a7; font-size: 20rpx; text-align: right; }.input-row { display: flex; align-items: center; min-height: 88rpx; border-bottom: 1rpx solid #f0eeea; }.input-row:first-of-type { margin-top: 8rpx; }.input-row:last-child { border-bottom: 0; }.label { width: 150rpx; color: #3d594c; font-size: 25rpx; font-weight: 600; }.input-field, .category-picker { flex: 1; color: #566f62; font-size: 24rpx; text-align: right; }.price-input { color: #ed633c; font-size: 28rpx; font-weight: 750; }.picker-value { color: #7a8e82; }.submit-button-container { position: fixed; right: 24rpx; bottom: 18rpx; left: 24rpx; z-index: 100; }.submit-button, .delete-button { display: flex; align-items: center; justify-content: center; width: 100%; height: 84rpx; margin: 0; border-radius: 17rpx; font-size: 28rpx; font-weight: 700; line-height: 84rpx; }.submit-button { background: #2f6b57 !important; color: #fff !important; box-shadow: 0 8rpx 16rpx rgba(47, 107, 87,.16); }.submit-button[disabled] { background: #c7cdd5 !important; }.delete-button { margin-top: 12rpx; border: 1rpx solid #f3cabc; background: #fff7f3 !important; color: #df633e !important; }.delete-button::after { border: 0; }

/* 专业/年级 picker 占位与选中态 */
.category-picker { display: flex; align-items: center; justify-content: flex-end; }
.picker-value { max-width: 100%; overflow: hidden; color: #3e6e59; font-size: 24rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.picker-value.picker-placeholder { color: #aab5ad; }
