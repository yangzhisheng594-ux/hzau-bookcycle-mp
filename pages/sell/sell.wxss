page { background: #f6f5f2; color: #2f6b57; }
.container { padding: 0 24rpx calc(160rpx + env(safe-area-inset-bottom)); }
.page-nav { display: flex; align-items: center; justify-content: center; height: calc(104rpx + env(safe-area-inset-top)); padding-top: env(safe-area-inset-top); box-sizing: border-box; }
.page-nav-title { color: #2f6b57; font-size: 31rpx; font-weight: 750; }
.section { margin-bottom: 22rpx; padding: 26rpx 22rpx; border: 1rpx solid #ebe8e2; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(47, 107, 87, .035); }
.section-title-row { display: flex; align-items: center; justify-content: space-between; }
.section-title { position: relative; margin-bottom: 21rpx; padding-left: 16rpx; color: #2f6b57; font-size: 32rpx; font-weight: 750; }
.section-title::before { position: absolute; top: 7rpx; left: 0; width: 6rpx; height: 29rpx; border-radius: 4rpx; background: #ef653e; content: ''; }
.section-title-cluster { display: flex; align-items: center; min-width: 0; }
.section-leaf-sprig { position: relative; width: 42rpx; height: 34rpx; margin: -2rpx 0 21rpx 9rpx; flex: none; }
.section-leaf-sprig::before { position: absolute; top: 6rpx; left: 19rpx; width: 2rpx; height: 25rpx; border-radius: 2rpx; background: #87ae7e; content: ''; transform: rotate(-36deg); transform-origin: bottom; }
.sprig-leaf { position: absolute; width: 15rpx; height: 9rpx; border-radius: 15rpx 0 15rpx 0; background: #b8d3ab; transform: rotate(-34deg); }
.leaf-one { top: 4rpx; left: 5rpx; }
.leaf-two { top: 14rpx; left: 18rpx; background: #d5e5c8; transform: rotate(29deg); }
.leaf-three { top: 22rpx; left: 5rpx; width: 12rpx; height: 8rpx; background: #e8c270; transform: rotate(-22deg); }
.section-title-row .section-title { margin-bottom: 21rpx; }
.sold-orders-link { padding-bottom: 21rpx; color: #71877b; font-size: 23rpx; }
.book-list { display: flex; flex-direction: column; }
.book-item { display: flex; align-items: center; padding: 19rpx 0; border-bottom: 1rpx solid #f0eeea; }
.book-item:last-child { padding-bottom: 0; border-bottom: 0; }
.book-cover { width: 120rpx; height: 156rpx; margin-right: 18rpx; border-radius: 12rpx; background: #eff3ef; flex-shrink: 0; }
.book-cover-placeholder { display: flex; align-items: center; justify-content: center; color: #9faea4; font-size: 21rpx; }
.book-info { display: flex; flex: 1; flex-direction: column; min-width: 0; min-height: 156rpx; padding: 3rpx 0; }
.book-name { display: -webkit-box; overflow: hidden; color: #294438; font-size: 28rpx; font-weight: 650; line-height: 1.42; text-overflow: ellipsis; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.book-detail-line { margin-top: 10rpx; color: #8f9f94; font-size: 21rpx; }
.book-code { display: inline-block; padding: 4rpx 9rpx; border-radius: 6rpx; background: #f4f6f2; }
.book-price { margin-top: auto; color: #ed633c; font-size: 28rpx; font-weight: 750; }
.seeking-price { color: #3e8067; }
.manage-button { display: flex !important; align-items: center !important; justify-content: center !important; min-width: 100rpx; height: 54rpx; margin-left: 14rpx; padding: 0 12rpx; border: 1rpx solid #e2ebe4; border-radius: 28rpx; background: #fff; color: #687d71; font-size: 23rpx; font-weight: 600; line-height: 1 !important; text-align: center; box-sizing: border-box; }
.respond-button { border-color: #dce8df; background: #edf7fb; color: #3e8067; }
.button-label { position: static; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; line-height: 1; text-align: center; }
.empty-list, .login-prompt { display: flex; flex-direction: column; align-items: center; padding: 50rpx 0; color: #9daaa1; font-size: 26rpx; text-align: center; }
.empty-icon { display: flex; align-items: center; justify-content: center; width: 106rpx; height: 106rpx; margin-bottom: 16rpx; border-radius: 50%; background: #f3f5f1; color: #829488; font-size: 21rpx; }
.publish-guidance-button { display: flex; align-items: center; justify-content: center; height: 66rpx; margin-top: 22rpx; padding: 0 30rpx; border-radius: 33rpx; background: #2f6b57; color: #fff; font-size: 25rpx; }
.list-footer-tip { padding-top: 18rpx; color: #9faea4; font-size: 23rpx; text-align: center; }
.publish-button-fixed { position: fixed; right: 0; bottom: 0; left: 0; z-index: 100; padding: 20rpx 42rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: rgba(246,245,242,.93); box-sizing: border-box; }
.publish-button { display: flex; align-items: center; justify-content: center; height: 86rpx; border-radius: 18rpx; background: #2f6b57; color: #fff; font-size: 29rpx; font-weight: 700; line-height: 86rpx; box-shadow: 0 10rpx 18rpx rgba(47, 107, 87, .18); }

/* 专业 / 年级 标签（华农本土化） */
.book-tag-line { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.book-tag { margin: 0 10rpx 6rpx 0; padding: 4rpx 12rpx; border-radius: 8rpx; background: #eef7ef; color: #45806a; font-size: 20rpx; line-height: 1.5; }
.book-tag.tag-grade { background: #fdf6e8; color: #9a7431; }
