<view class="container">
  <!-- 顶部栏 -->
  <view class="header">
    <text class="title">购物车</text>
    <view class="header-right">
      <view class="manage-container">
        <text class="manage-btn" bindtap="toggleManageMode">{{isManageMode ? '完成' : '管理'}}</text>
      </view>
    </view>
  </view>

  <!-- 中间内容区域 -->
  <view class="content-section">
    <view class="cart-caption" wx:if="{{books.length > 0}}">已为你保留 {{books.length}} 本好书</view>
    <view wx:if="{{books.length > 0}}">
      <view class="product-item" wx:for="{{books}}" wx:key="cartItemId" wx:for-item="book" wx:for-index="index"> <!-- 建议 key 使用 cartItemId 更唯一 -->
        <checkbox class="product-checkbox" checked="{{book.selected}}" bindtap="toggleSelect" data-index="{{index}}"></checkbox>
        <image class="product-cover" src="{{book.coverUrl || ''}}" mode="aspectFill"></image> <!-- 如果没有默认图，src 为空字符串 -->
        <view class="product-info">
          <view class="product-title">{{book.title}}</view>
          <view class="product-spec">{{book.spec}}</view>
          <!-- !!! 修改点：直接使用格式化好的 displayPrice !!! -->
          <view class="product-price" wx:if="{{book.displayPrice !== undefined}}">¥{{book.displayPrice}}</view>
          <view class="product-price" wx:else>¥0.00</view> <!-- 如果 displayPrice 也没有，显示0.00 -->
        </view>
      </view>
    </view>
    <view wx:else class="empty-cart">
      <text>购物车还是空的哦，快去逛逛吧～</text>
    </view>
  </view>

  <!-- 底部栏 -->
  <view class="footer">
    <label class="checkbox-label">
      <checkbox class="checkbox" checked="{{isAllSelected}}" bindtap="toggleSelectAll" disabled="{{books.length === 0}}"></checkbox>
      <text>全选</text>
    </label>
    <view class="total" wx:if="{{!isManageMode}}">
      <text>合计：</text>
      <text class="price">¥{{totalPrice}}</text>
    </view>
    <view class="total-selected" wx:else> <!-- 使用之前建议的 .total-selected 类名 -->
      <text>已选{{selectedCount}}件</text>
    </view>
    <button
      class="checkout-btn {{isManageMode ? 'delete-mode' : ''}}"
      bindtap="{{isManageMode ? 'deleteSelected' : 'checkout'}}"
      disabled="{{selectedCount === 0}}"
    >
      {{isManageMode ? '删除' : '结算'}}({{selectedCount}})
    </button>
  </view>
</view>
