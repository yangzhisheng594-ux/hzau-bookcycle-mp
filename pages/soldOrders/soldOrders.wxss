page { background: #f6f5f2; }.page-wrap { min-height: 100vh; padding: 0 24rpx 32rpx; box-sizing: border-box; }.page-nav { position: relative; display: flex; align-items: center; justify-content: center; height: 104rpx; }.nav-title { color: #2f6b57; font-size: 31rpx; font-weight: 750; }.nav-back { position: absolute; left: 0; top: 26rpx; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border: 1rpx solid #dfe9e1; border-radius: 14rpx; background: #fff; color: #2c463b; font-size: 48rpx; font-weight: 300; line-height: 46rpx; box-sizing: border-box; }
.order-card { margin-bottom: 18rpx; padding: 0 21rpx 20rpx; border: 1rpx solid #ebe8e2; border-radius: 22rpx; background: #fff; box-shadow: 0 7rpx 18rpx rgba(47, 107, 87,.03); }.order-header { display: flex; justify-content: space-between; height: 76rpx; align-items: center; border-bottom: 1rpx solid #f0eeea; color: #8893a2; font-size: 21rpx; }.status { padding: 5rpx 10rpx; border-radius: 6rpx; font-weight: 650; }.pendingShipment { background: #fff6ef; color: #d9784d; }.pendingReceipt { background: #edf6ef; color: #4d806b; }.completed { background: #f3f5f1; color: #7b8797; }.afterSales { background: #fff0f0; color: #c95c5c; }.book-row { display: flex; padding: 18rpx 0 6rpx; }.cover { width: 116rpx; height: 150rpx; border-radius: 10rpx; background: #eff3ef; flex: none; }.cover-placeholder { display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 20rpx; }.book-info { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 3rpx 0 2rpx 17rpx; }.title { color: #294438; font-size: 27rpx; font-weight: 650; line-height: 1.42; }.meta { margin-top: 8rpx; color: #83998d; font-size: 21rpx; }.price { margin-top: auto; color: #ed633c; font-size: 28rpx; font-weight: 750; }.actions { display: flex; justify-content: flex-end; padding-top: 12rpx; }.actions button { display: flex; align-items: center; justify-content: center; min-width: 138rpx; height: 58rpx; margin: 0; border-radius: 14rpx; background: #2f6b57; color: #fff; font-size: 23rpx; line-height: 58rpx; }.empty, .state { padding: 100rpx 0; color: #9daaa1; font-size: 26rpx; text-align: center; }.retry, .more { padding: 26rpx 0; color: #df633e; }
