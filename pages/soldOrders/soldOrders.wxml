<view class="page-wrap">
  <view class="page-nav"><view class="nav-back" bindtap="goBack">‹</view><text class="nav-title">售出订单</text></view>
  <view class="order-list" wx:if="{{orders.length}}"><view class="order-card" wx:for="{{orders}}" wx:key="orderItemId"><view class="order-header"><text>订单 {{item.orderNumber}}</text><text class="status {{item.statusClass}}">{{item.statusText}}</text></view><view class="book-row"><image class="cover" wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" /><view class="cover cover-placeholder" wx:else>暂无封面</view><view class="book-info"><view class="title">{{item.title}}</view><view class="meta">{{item.courseCode || '课程教材'}}</view><view class="meta">买家：{{item.buyerName}}</view><view class="price">¥{{item.displayPrice}} · ×{{item.quantity}}</view></view></view><view class="actions" wx:if="{{item.status === 'pending'}}"><button bindtap="shipItem" data-id="{{item.orderItemId}}">确认面交</button></view></view></view>
  <view class="empty" wx:elif="{{!isLoading && !loadFailed}}">暂无售出订单</view><view class="state" wx:if="{{isLoading}}">正在加载…</view><view class="state retry" wx:if="{{loadFailed}}" bindtap="retryLoad">加载失败，点击重试</view><view class="state more" wx:if="{{hasMore && !isLoading}}" bindtap="loadMore">加载更多</view>
</view>
